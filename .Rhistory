shiny::runApp('C:/date/covid_fractional_sir_project')
dfc <- covid_data |>
dplyr::filter(country == "Romania") |>
dplyr::arrange(date)
dfc |>
dplyr::summarise(
max_new_confirmed = max(new_confirmed, na.rm = TRUE),
max_new_deaths = max(new_deaths, na.rm = TRUE),
max_new_recovered = max(new_recovered, na.rm = TRUE)
)
dfc |>
dplyr::filter(new_confirmed == max(new_confirmed, na.rm = TRUE) |
new_recovered == max(new_recovered, na.rm = TRUE) |
new_deaths == max(new_deaths, na.rm = TRUE)) |>
dplyr::select(date, new_confirmed, new_deaths, new_recovered)
output$plot_series <- renderPlot({
dfc <- country_data()
req(nrow(dfc) > 0)
dfp <- dfc |>
dplyr::mutate(
ma_confirmed = as.numeric(stats::filter(new_confirmed, rep(1/7, 7), sides = 1)),
ma_deaths = as.numeric(stats::filter(new_deaths, rep(1/7, 7), sides = 1)),
ma_recovered = as.numeric(stats::filter(new_recovered, rep(1/7, 7), sides = 1))
)
ggplot(dfp, aes(x = date)) +
geom_line(aes(y = ma_confirmed, color = "New confirmed (7-day MA)"), linewidth = 0.7) +
geom_line(aes(y = ma_deaths, color = "New deaths (7-day MA)"), linewidth = 0.7) +
geom_line(aes(y = ma_recovered, color = "New recovered (7-day MA)"), linewidth = 0.7) +
labs(
title = paste("Daily COVID-19 series -", input$country),
x = "Date",
y = "Counts",
color = ""
) +
theme_minimal(base_size = 12)
})
runApp('C:/date/covid_fractional_sir_project')
